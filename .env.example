# Application
APP_ENV=development
APP_PORT=8000

# Database (Neon PostgreSQL)
NEON_DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
# Must include +psycopg driver tag (project uses psycopg v3, not psycopg2):
#   postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=
DOCKER_DATABASE_URL=

# Object storage (Cloudflare R2)
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Application security
SECRET_KEY=

# AI (Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
